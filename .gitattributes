# GitHub Linguist - Dil tespitini TypeScript olarak zorla
*.tsx linguist-language=TypeScript
*.ts linguist-language=TypeScript

# HTML dosyalarını dil istatistiğinden çıkar
index.html linguist-detectable=false
public/* linguist-detectable=false

# Test raporlarını "oluşturulmuş" olarak işaretle → Linguist saymasın
playwright-report/* linguist-generated=true
test-results/* linguist-generated=true
e2e/* linguist-detectable=false
